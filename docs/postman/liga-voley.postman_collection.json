    {
      "name": "1. Registro → login → current → logout → current 401",
      "description": "Flujo de autenticación con un usuario nuevo en cada corrida.",
      "item": [
        {
          "name": "Registro de un usuario nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newUserEmail', `postman.${Date.now()}@ligavoley.test`)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201))",
                  "pm.test('no expone password ni hashes', () => pm.expect(pm.response.text()).to.not.match(/password|\\$2[aby]\\$/))",
                  "pm.test('el rol del body se ignora: queda user', () => pm.expect(pm.response.json().payload.role).to.eql('user'))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
